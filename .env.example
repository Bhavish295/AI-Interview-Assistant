# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/interview-assistant

# Long random string used to sign session JWTs
JWT_SECRET=replace-with-a-long-random-string

# Google Gemini API key — https://aistudio.google.com/apikey
# If unset, AI evaluation falls back gracefully instead of erroring.
GEMINI_API_KEY=

# Optional: seed an admin account when running `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
